# Runtime connection through the Supabase transaction pooler.
DATABASE_URL="postgresql://USER:PASSWORD@POOLER_HOST:6543/postgres?pgbouncer=true"

# Direct or session-pooler connection used by Prisma CLI and migrations.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_OR_POOLER_HOST:5432/postgres"

# Secret used to sign authentication tokens. Use a long, random value locally.
JWT_SECRET="replace-with-a-long-random-secret"

# Optional. Port the API listens on. Defaults to 3001.
PORT="3001"

# Frontend origin allowed by CORS. In production, use the GitHub Pages origin.
FRONTEND_ORIGIN="https://luis-botelho.github.io"

# Resend credentials for the public research form (to be used by its API route).
RESEND_API_KEY="re_xxxxxxxxx"
RESEARCH_FROM_EMAIL="SafeAnchor <pesquisa@safeanchor.app>"
RESEARCH_INBOX="pesquisa@safeanchor.app"

