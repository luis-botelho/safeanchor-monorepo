generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
}

model Vessel {
  id           String  @id @default(cuid())
  ownerPartyId String?
  name         String
  type         String
  status       String
  category     String?
  length       String?
  year         String?
  engine       String?
  registration String?
  location     String?
  mission      String?
  imageSeed    String?

  ownerParty             Party?                  @relation(fields: [ownerPartyId], references: [id])
  maintenances           Maintenance[]
  preventiveMaintenances PreventiveMaintenance[]
  checklistExecutions    ChecklistExecution[]
  documents              Document[]
  inspections            Inspection[]

  @@index([ownerPartyId])
}

model Maintenance {
  id          String @id @default(cuid())
  vesselId    String
  title       String
  description String
  type        String
  date        String
  status      String

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([vesselId])
}

model PreventiveMaintenance {
  id            String @id @default(cuid())
  title         String
  description   String
  type          String
  status        String
  vesselId      String
  periodicity   String
  startDate     String
  nextExecution String

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([vesselId])
}

model ChecklistTemplate {
  id         String               @id @default(cuid())
  title      String
  vesselType String
  items      Json
  executions ChecklistExecution[]
}

model ChecklistExecution {
  id         String @id @default(cuid())
  templateId String
  vesselId   String
  responses  Json
  executedAt String

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  vessel   Vessel            @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([templateId])
  @@index([vesselId])
}

model Document {
  id         String @id @default(cuid())
  vesselId   String
  name       String
  category   String
  number     String
  validFrom  String
  expiresAt  String
  provider   String?

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([vesselId])
}

enum InspectionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Inspection {
  id          String           @id @default(cuid())
  vesselId    String
  type        String
  status      InspectionStatus @default(SCHEDULED)
  scheduledAt String
  completedAt String?
  inspector   String
  notes       String?
  checklist   Json
  certificate Json?
  createdAt   String

  vessel Vessel @relation(fields: [vesselId], references: [id], onDelete: Cascade)

  @@index([vesselId])
}

enum PartyType {
  USER
  ORGANIZATION
}

enum UserRole {
  USER
  MANAGER
  ADMIN
  DIRECTOR
}

enum Persona {
  OWNER
  SERVICE_PROVIDER
  MARINA
}

model Party {
  id           String        @id @default(cuid())
  type         PartyType
  user         User?
  organization Organization?
  vessels      Vessel[]
}

model User {
  id           String   @id @default(cuid())
  partyId      String   @unique
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(USER)
  persona      Persona  @default(OWNER)

  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Organization {
  id      String @id @default(cuid())
  partyId String @unique
  name    String

  party       Party        @relation(fields: [partyId], references: [id], onDelete: Cascade)
  memberships Membership[]
}

model Membership {
  id             String @id @default(cuid())
  userId         String
  organizationId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Respostas da pesquisa capturadas somente com consentimento explícito.
model ResearchResponse {
  id             String   @id @default(cuid())
  consentVersion String
  acceptedAt     String
  name           String?
  contact        String?
  city           String?
  profile        String?
  answers        Json
  summary        String
  status         String   @default("NEW")
  decision       String?
  createdAt      String

  @@index([status])
  @@index([profile])
  @@index([city])
}

// Registro mínimo das decisões tomadas pela diretoria.
model DirectorAction {
  id         String   @id @default(cuid())
  actorId    String
  targetType String
  targetId   String
  action     String
  details    Json
  createdAt  String

  @@index([actorId])
  @@index([targetType, targetId])
}
