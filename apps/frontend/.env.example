# Base URL of the SafeAnchor backend API.
#
# Local development fallback:
#   VITE_API_URL="http://localhost:3001"
#
# Production: set this to the deployed backend URL at build time.
#   VITE_API_URL="https://api.example.com"
#
# If unset, the app falls back to localhost:3001 in dev mode only.
VITE_API_URL="http://localhost:3001"