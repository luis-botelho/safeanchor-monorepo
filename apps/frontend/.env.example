# Base URL of the SafeAnchor backend API.
#
# Local development fallback:
#   VITE_API_URL="http://localhost:3001"
#
# Production: set this to the deployed backend URL at build time.
#   VITE_API_URL="https://api.example.com"
#
# Configure VITE_API_URL as a GitHub Actions repository variable for Pages.
# The Resend API key belongs only in the backend environment, never here.
VITE_API_URL="http://localhost:3001"

# Opcional: mantém o botão para compartilhar por WhatsApp.
# Deixe vazio para esconder essa opção.
#
# Somente numeros, com codigo do pais e DDD.
VITE_RESEARCH_WHATSAPP="5511999999999"
# Destino sugerido para o link manual de e-mail na página de confirmação.
VITE_RESEARCH_INBOX="pesquisa@safeanchor.app"
